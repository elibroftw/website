---
import { withBase } from '$lib/paths';

const logo = withBase('/static/images/cloud_copy_logo.png');
const favicon = withBase('/static/images/cloud_copy_favicon.ico');
const stylesheet = withBase('/static/css/cloud_copy.css?v=1.0');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Cloud Copy</title>
    <link href={logo} rel="icon" type="image/png" />
    <link href={favicon} rel="shortcut icon" />
    <link href={stylesheet} rel="stylesheet" />
    <link href="//fonts.googleapis.com/css?family=Offside" rel="stylesheet" type="text/css" />
    <link href="//fonts.googleapis.com/css?family=Ubuntu" rel="stylesheet" type="text/css" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#008b8b" />
  </head>
  <body>
    <div class="row">
      <ul class="main-nav">
        <li><a id="nav-about" href="#about">About</a></li>
        <li><a id="nav-download" href="#download">Download</a></li>
      </ul>
    </div>
    <div class="hero">
      <h1><img id="logo" src={logo} alt="Cloud Copy logo" /> Cloud Copy</h1>
      <button id="demo-btn" class="btn-one" onclick="openModal()">Watch Demo</button>
      <div id="modal" class="modal">
        <iframe
          allowfullscreen
          width="66%"
          height="75%"
          class="modal-content"
          title="Cloud Copy demo"
          src="//www.youtube-nocookie.com/embed/k_FxkNObDYQ?enablejsapi=1&version=3&playerapiid=ytplayer"></iframe>
      </div>
    </div>

    <div id="about">
      <h2>About</h2>
      <div class="background">
        <div class="transbox">
          <p>
            Cloud Copy is a novel solution to clipboard management. It allows you to send copy text/content on one
            device, and paste it directly into another, seamlessly. <br /><br />
            Cloud Copy differentiates itself from other clipboard applications by not depending on Chrome, or any
            browser you use. Versatile across all platforms, connect all your devices with a single account.
            <br /><br />
            Made by Abdullah Hadi, Elijah Lopez, Gijsson Yeo, and Kritik Kaushal.
            <a href="//github.com/elibroftw/cloud-copy">Source code</a>.
          </p>
        </div>
      </div>
    </div>

    <div id="download">
      <h2>Download</h2>
      <div id="downloads">
        <div id="windows">
          <ul>
            <li>
              <a class="dl-link" href="//github.com/elibroftw/cloud-copy/releases/download/v0.1.2a/Cloud.Copy.exe">
                Windows x64
              </a>
            </li>
          </ul>
        </div>
        <div id="mac">
          <ul><li><a class="dl-link" href="">MacOS</a></li></ul>
        </div>
        <div id="linux">
          <hX>Linux</hX>
          <ul>
            <li><a class="dl-link" href="">64 bit</a></li>
            <li><a class="dl-link" href="">ARM</a></li>
          </ul>
        </div>
        <div id="mobile">
          <hX>Mobile</hX>
          <ul>
            <li><a class="dl-link" href="">Android</a></li>
            <li><a class="dl-link" href="">iOS</a></li>
          </ul>
        </div>
      </div>
    </div>

    <button onclick="topFunction()" id="btn-top" title="Go to top">
      <svg class="arrow up" xmlns="http://www.w3.org/2000/svg" viewBox="5 0 50 80" xml:space="preserve">
        <polyline
          fill="none"
          stroke="#FFFFFF"
          stroke-width="8"
          stroke-linecap="round"
          stroke-linejoin="round"
          points="0.375, 35.375 28.375, 0.375 58.67, 35.375"
        ></polyline>
      </svg>
    </button>

    <script is:inline>
      const modal = document.getElementById('modal');
      const ytVid = document.getElementsByTagName('iframe')[0];
      const toTopBtn = document.getElementById('btn-top');

      function closeModal() {
        modal.style.display = 'none';
        ytVid.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
        window.onclick = null;
        document.onkeydown = null;
      }

      function openModal() {
        if (document.body.clientWidth < 690) {
          return window.open('https://youtube.com/watch?v=k_FxkNObDYQ');
        }
        modal.style.display = 'block';
        ytVid.contentWindow.postMessage('{"event":"command","func":"playVideo","args":""}', '*');
        document.onkeydown = function (event) {
          if (event.key === 'Escape') closeModal();
        };
        window.onclick = function (event) {
          if (event.target == modal) closeModal();
        };
      }

      function scrollFunction() {
        toTopBtn.style.display =
          document.body.scrollTop > 20 || document.documentElement.scrollTop > 20 ? 'block' : 'none';
      }

      function topFunction() {
        document.body.scrollTop = 0;
        document.documentElement.scrollTop = 0;
        document.getElementById('demo-btn').focus();
      }

      window.onscroll = scrollFunction;
    </script>
  </body>
</html>